# Anthropic
ANTHROPIC_API_KEY=sk-ant-xxxxx

# Twilio
TWILIO_ACCOUNT_SID=ACxxxxx
TWILIO_AUTH_TOKEN=xxxxx
TWILIO_PHONE_NUMBER=+966xxxxxxxxx

# Deepgram (STT)
DEEPGRAM_API_KEY=xxxxx

# ElevenLabs (TTS)
ELEVENLABS_API_KEY=xxxxx
ELEVENLABS_VOICE_ID=xxxxx

# MongoDB Atlas
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/voice_agent?retryWrites=true&w=majority
MONGODB_DATABASE=voice_agent

# Application
APP_BASE_URL=https://your-domain.com
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# ChromaDB
CHROMA_HOST=chromadb
CHROMA_PORT=8001

# RAG
EMBEDDING_MODEL=intfloat/multilingual-e5-large
CHUNK_SIZE=512
CHUNK_OVERLAP=50
